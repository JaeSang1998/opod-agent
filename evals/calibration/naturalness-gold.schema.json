{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opod.dev/schemas/naturalness-gold.schema.json",
  "title": "OPOD naturalness human calibration set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "source",
    "review",
    "trajectoryVerdicts",
    "annotations",
    "pairwiseReviews"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "naturalness-human-calibration" },
    "status": { "enum": ["seed", "adjudicated"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "suiteReportSha256", "reviewedOn"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "suiteReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerCount", "blind", "method"],
      "properties": {
        "reviewerCount": { "type": "integer", "minimum": 1 },
        "blind": { "type": "boolean" },
        "method": { "enum": ["posthoc", "independent-blind"] }
      }
    },
    "trajectoryVerdicts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trajectoryVerdict" }
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/annotation" }
    },
    "pairwiseReviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/pairwiseReview" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "adjudicated" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "reviewerCount": { "minimum": 2 },
              "blind": { "const": true },
              "method": { "const": "independent-blind" }
            },
            "required": ["reviewerCount", "blind", "method"]
          }
        }
      }
    }
  ],
  "$defs": {
    "verdict": { "enum": ["pass", "fail"] },
    "humanVerdict": { "enum": ["pass", "fail", "abstain", "not-reviewed"] },
    "tag": {
      "enum": [
        "calibration_mismatch",
        "local_relevance",
        "natural_korean",
        "mutuality",
        "persona_without_motif",
        "source_restraint",
        "topic_diversity",
        "register_fit",
        "world_state_restraint"
      ]
    },
    "trajectoryVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcriptId",
        "scenarioId",
        "automaticVerdict",
        "humanVerdict",
        "effectiveVerdict",
        "evidenceIds"
      ],
      "properties": {
        "transcriptId": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "automaticVerdict": { "$ref": "#/$defs/verdict" },
        "humanVerdict": { "$ref": "#/$defs/humanVerdict" },
        "effectiveVerdict": { "$ref": "#/$defs/verdict" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^human-\\d{3}$" }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "assessment", "transcriptId", "excerpt", "tags", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^human-\\d{3}$" },
        "kind": { "enum": ["turn", "trajectory", "verdict"] },
        "assessment": { "enum": ["failure", "verdict-override", "boundary"] },
        "transcriptId": { "type": "string", "minLength": 1 },
        "turn": { "type": "integer", "minimum": 1 },
        "excerpt": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tag" }
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "turn" } } },
          "then": { "required": ["turn"] },
          "else": { "not": { "required": ["turn"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "verdict" } } },
          "then": { "properties": { "assessment": { "const": "verdict-override" } } },
          "else": { "properties": { "assessment": { "not": { "const": "verdict-override" } } } }
        }
      ]
    },
    "pairwiseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "leftTranscriptId",
        "rightTranscriptId",
        "presentedFirst",
        "winner",
        "reviewerAlias"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "leftTranscriptId": { "type": "string", "minLength": 1 },
        "rightTranscriptId": { "type": "string", "minLength": 1 },
        "presentedFirst": { "enum": ["left", "right"] },
        "winner": { "enum": ["left", "right", "tie", "abstain"] },
        "reviewerAlias": { "type": "string", "minLength": 1 }
      }
    }
  }
}
