{
  "name": "opod-agent",
  "version": "0.1.0",
  "description": "Character-chat AI Agent service for OPOD — OpenAI-compatible chat with dynamic persona and layered memory.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:gemma": "bash scripts/dev-gemma.sh",
    "start": "node dist/index.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:web": "pnpm --dir web build",
    "check": "npm run lint && npm run dead-code && npm run typecheck && npm run typecheck:eval && npm run test:coverage && npm run test:eval:coverage && npm run build && npm run typecheck:web && npm run test:web && npm run build:web",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dead-code": "knip",
    "lint": "biome lint src evals web",
    "eval:validate": "tsx evals/cli.ts validate",
    "eval:smoke": "tsx --env-file=.env evals/cli.ts run --profile smoke",
    "eval:long": "tsx --env-file=.env evals/cli.ts run --profile standard",
    "eval:confidence": "tsx --env-file=.env evals/cli.ts run --profile confidence",
    "eval:naturalness": "tsx --env-file=.env evals/cli.ts run --suite evals/cases/character-naturalness-baseline.json",
    "eval:memory-structure": "EVAL_TARGET_PROVIDER=deterministic EVAL_TARGET_MODEL=memory-structure-deterministic EVAL_SIMULATOR_BASE_URL=http://127.0.0.1 EVAL_SIMULATOR_MODEL=not-used EVAL_CONSOLIDATION_MODE=none tsx evals/cli.ts run --profile smoke --suite evals/cases/p1-memory-structure.json --turns 1 --skip-judge",
    "eval:persona-router": "tsx evals/persona-router-cli.ts",
    "eval:review:prepare": "tsx evals/cli.ts review-prepare",
    "eval:review:aggregate": "tsx evals/cli.ts review-aggregate",
    "eval:harbor:validate": "UV_CACHE_DIR=/tmp/opod-harbor-uv-cache uv run --isolated --with 'harbor==0.20.0' python evals/harbor/validate.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:eval": "tsc -p tsconfig.evals.json --noEmit",
    "test": "vitest run",
    "test:eval": "vitest run --config vitest.evals.config.ts",
    "test:eval:coverage": "vitest run --config vitest.evals.config.ts --coverage",
    "test:coverage": "vitest run --coverage",
    "test:web": "pnpm --dir web test:coverage",
    "typecheck:web": "pnpm --dir web typecheck",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "openai": "^4.77.0",
    "pg": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.9",
    "knip": "^6.27.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
